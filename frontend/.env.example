# =============================================================================
# Aurora Store - frontend configuration
# =============================================================================
#
# HOW TO USE THIS FILE
#
#   1. cp .env.example .env
#   2. Adjust values if needed
#   3. Restart the dev server (Vite reads .env once, at startup)
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle. This is
# a safety mechanism, not a naming convention: anything else in this file stays
# on the build machine. It is also why no secret can ever live here - the
# browser bundle is public, and a "hidden" key would be one DevTools tab away.
#
# -----------------------------------------------------------------------------

# Where the API lives - an ORIGIN, not a path prefix.
#
# Leave this EMPTY for local development, which is the default. Empty means every
# request path stays relative (`/api/products`), so it goes to whatever origin
# served the page:
#
#   1. The Vite dev server proxies /api to the backend (see vite.config.js), so
#      the browser sees a same-origin request. No CORS handshake, and no
#      preflight round-trip on every write.
#   2. The production build needs no change at all - nginx or equivalent serves
#      the static files and forwards /api, and the same relative path works.
#
# IMPORTANT - this is a prefix, not a replacement for "/api".
# Every call site already writes the full path, e.g. `http.get('/api/products')`.
# The value here is prepended to that:
#
#     (unset)                         ->  /api/products
#     VITE_API_BASE_URL=http://api.example.com  ->  http://api.example.com/api/products
#
# So DO NOT set this to "/api" - that would produce "/api/api/products" and every
# request would 404. Set it only when the API genuinely lives on a different
# origin, and use a full origin with no trailing slash.
VITE_API_BASE_URL=

# Human-readable application name, shown in the header, the footer, the home hero and the
# document title. Kept in configuration rather than hardcoded so white-labelling does not
# require a code change.
#
# Read in one place: src/config.js. Everything that displays it imports from there, so this
# value cannot end up applied to the header but not the tab title.
VITE_APP_NAME=Aurora

# Default page size for product listings, used by the catalogue and the admin product table.
# The backend caps this at 100 and clamps are applied in src/config.js.
#
# 12 divides evenly into the 2/3/4-column grid at the layout's breakpoints, so the last row is
# never a lonely orphan on common screen sizes.
VITE_PRODUCTS_PAGE_SIZE=12

# Origin the demo product images are served from.
#
# Informational: the seed data carries absolute image URLs, so this is a hint for recognising a
# placeholder rather than a prefix that paths are built from. Blank is valid and means "do not
# special-case anything", which is the right setting once real assets replace the placeholders.
VITE_IMAGE_HOST=https://picsum.photos

# -----------------------------------------------------------------------------
# Verifying these actually take effect
# -----------------------------------------------------------------------------
#
# A documented setting that nothing reads is worse than an undocumented one: it looks like
# configuration and behaves like a comment. `scripts/config-check.cjs` asserts the RENDERED
# page, so a variable that reaches `.env` but not the UI fails loudly instead of silently.
#
#   npm run dev
#   node scripts/config-check.cjs "<chrome-path>" http://localhost:5173 <expected-name> <expected-size>
#
# Both paths are worth checking: with this file copied to `.env` the custom values must appear,
# and with no `.env` at all the fallbacks in src/config.js must apply.
