# =============================================================================
# Aurora Store - backend configuration
# =============================================================================
#
# HOW TO USE THIS FILE
#
#   1. cp .env.example .env
#   2. Fill in real values in .env
#   3. Export them before starting the app.
#
# This file is an EXAMPLE. The real .env is git-ignored and must never be
# committed. Nothing in here is a real secret - every value is a placeholder.
#
# The application reads these through Spring's normal property resolution
# (`${DB_URL}` etc. in application.yml), which means an environment variable
# wins over anything written in the yml. That is deliberate: the yml holds
# development-friendly defaults, and production supplies real secrets from the
# environment. No secret is ever read from a file that gets committed.
#
# The variable NAMES below are exactly the ones application.yml declares.
# Run this to list them yourself:
#   grep -oE '\$\{[A-Z_0-9]+' src/main/resources/application.yml | sort -u
#
# On Windows / Git Bash:
#     set -a; source .env; set +a
# On Windows / PowerShell:
#     Get-Content .env | ForEach-Object { if ($_ -match '^\s*([^#][^=]*)=(.*)$') { Set-Item -Path "env:$($matches[1].Trim())" -Value $matches[2].Trim() } }
# On Linux / macOS:
#     export $(grep -v '^#' .env | xargs)
#
# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------

# JDBC URL. The timezone and character-set parameters are not optional garnish:
# without serverTimezone the driver can shift timestamps, and without
# characterEncoding MySQL is free to mangle non-ASCII product names.
#
# characterEncoding=utf8 maps to utf8mb4 in Connector/J 8+, which is what you
# want - it is the only encoding with full 4-byte support, so it is the only
# one that can store an emoji in a product description without truncating.
DB_URL=jdbc:mysql://localhost:3306/ecommerce_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8

# Database credentials. In production use a dedicated, least-privilege account -
# never `root`. The application needs SELECT/INSERT/UPDATE/DELETE plus, if you
# run db/schema.sql at startup, DDL. It does not need GRANT or FILE.
DB_USERNAME=root
DB_PASSWORD=root

# -----------------------------------------------------------------------------
# JWT  *** the one setting that has no safe default ***
# -----------------------------------------------------------------------------
#
# MUST be at least 32 bytes (256 bits), because HS256 uses the key length as
# the security parameter. The backend has no fallback value: if this is absent
# the application refuses to start. That failure is intentional - adding a
# default would mean every deployment that forgot to set it would be signing
# tokens with the same publicly-known key.
#
# Generate one with:
#     openssl rand -base64 48
#
# Rotating this invalidates every issued token at once. That is the correct
# behaviour for a compromised secret, and it is also why the value is per-
# environment: sharing it across environments would mean a staging token is
# accepted in production.
JWT_SECRET=replace-with-openssl-rand-base64-48-output-at-least-32-bytes

# Token lifetime in milliseconds. 3600000 = 1 hour.
# Short enough that a leaked token has a bounded blast radius; long enough that
# a user is not asked to sign in mid-session.
JWT_EXPIRATION_MS=3600000

# The `iss` claim written into every token and verified on every request.
# It distinguishes tokens issued by this service from tokens issued by another
# service that happens to share a signing key.
JWT_ISSUER=aurora-store

# -----------------------------------------------------------------------------
# GOOGLE OAUTH2 / OIDC
# -----------------------------------------------------------------------------
#
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI to register:
#     http://localhost:8080/login/oauth2/code/google
#
# Leave these blank to run without Google sign-in, which is the default for a
# local checkout. When blank the OAuth2 client is not registered, the frontend
# hides the Google button, and /api/health reports:
#     "googleEnabled": false
# That is a supported configuration, not a broken one.
#
# SECURITY NOTE: a user who authenticates via Google is ALWAYS given role
# CUSTOMER. The role is never derived from anything the identity provider
# sends, because a provider is not authoritative about authorisation in this
# application. See docs/05-SECURITY.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the OAuth2 flow sends the browser once it completes.
# In development this is the Vite dev server, not the backend, because that is
# where the SPA that needs to pick up the token is running.
OAUTH2_REDIRECT_URI=http://localhost:5173/oauth2/redirect

# Origins allowed to call the API from a browser. Comma-separated.
# Only needed when the frontend is served from a different origin than the API;
# the Vite dev proxy makes development same-origin, so this is chiefly a
# production setting.
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------

# Server port. Change this if 8080 is already taken - 8080 is a popular port,
# and a lingering Tomcat from another project is a common cause of a confusing
# "port in use" failure. Check what holds it with: jps -l -v
SERVER_PORT=8080
